datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

/// AppConfig is keyed by tenant (each Chatwoot AgentBot = one tenant).
/// Stores per-tenant org identity, behavior, handoff, and the Chatwoot API
/// token.  Model and retrieval config live in GlobalConfig (shared by all
/// tenants); the fields are kept here as nullable so a per-tenant override
/// can be added in the future without a schema change.
model AppConfig {
  id                 String   @id
  orgName            String?
  orgPhone           String?
  orgSchedule        String?
  orgAddress         String?
  orgWebsite         String?
  orgEOffice         String?
  preferredLang      String?
  responseStyle      String?
  customInstructions String?
  greetingMessage    String?
  outOfScopeMessage  String?
  chatwootApiToken   String?
  enableHandoff      Boolean?
  handoffTeamId      String?
  handoffAssigneeId  String?
  updatedAt          DateTime @default(now()) @updatedAt

  @@map("app_config")
  @@schema("app")
}

/// Global configuration shared by all tenants. Stores the instance-wide
/// model and retrieval defaults that Super Admin configures.
model GlobalConfig {
  id              String   @id @default("default")
  llmModel        String?
  llmModelSmall   String?
  embedModel      String?
  retrievalTopK   Int?
  retrievalFinalK Int?
  updatedAt       DateTime @default(now()) @updatedAt

  @@map("global_config")
  @@schema("app")
}

enum DocumentStatus {
  pending
  indexing
  indexed
  error
  deleting

  @@schema("app")
}

enum SourceType {
  web
  pdf
  docx
  txt

  @@schema("app")
}

model IndexedDocument {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String
  source       String
  sourceType   SourceType
  title        String?
  status       DocumentStatus @default(pending)
  errorMessage String?
  chunkCount   Int            @default(0)
  contentHash  String?
  s3Key        String?
  autoReindex  Boolean        @default(false)
  indexedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt

  @@unique([tenantId, source, sourceType])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("indexed_documents")
  @@schema("app")
}
